# =================================================================
# AttendoSchool — Unified Environment Configuration Template
# All API keys, credentials, and settings are self-contained here.
# No external credential files required.
# =================================================================

# Server Port & Core Settings
PORT=5000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-for-local-testing-12345

# Database Persistence Engine ('firebase' | 'postgres')
DB_DRIVER=firebase
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/school_attendance

# -----------------------------------------------------------------
# Firebase Cloud Firestore Credentials (Self-Contained in .env)
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative: Raw JSON String or Base64 of the Service Account
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_mock12345

# Payment Gateway (Mock / Sandbox)
RAZORPAY_KEY_ID=rzp_test_mock12345
RAZORPAY_KEY_SECRET=rzp_test_mocksecret12345
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Communications & SMS Settings (Mock mode for local dev)
SMS_PROVIDER=mock
SMS_SENDER_ID=ATTNDO

# Billing & Tax Configurations
COMPANY_NAME="School Attendance SaaS"
COMPANY_GSTIN="19AAACB1234P1Z5"
COMPANY_ADDRESS="Campus 4, Tech Park Boulevard, Bengaluru, Karnataka"
COMPANY_PHONE="+91 90000 00000"
COMPANY_GST_RATE=18

# -----------------------------------------------------------------
# Outgoing SMTP Mail Server Configuration (e.g. Gmail, SendGrid, SES)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="AttendoSchool <your-email@gmail.com>"
SMTP_FROM_NAME="AttendoSchool"
SMTP_REPLY_TO=your-email@gmail.com
EMAIL_ENABLED=true

