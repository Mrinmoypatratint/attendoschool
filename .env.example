# =================================================================
# AttendoSchool — Unified Environment Configuration Template
# All API keys, credentials, and settings are self-contained here.
# No external credential files required.
# =================================================================

# Server Port & Core Settings
PORT=5000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-key-here

# Database Persistence Engine (100% Supabase PostgreSQL Pooler)
DB_DRIVER=postgres
USE_POSTGRES=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
SECONDARY_DB=none
ENABLE_DUAL_DB_SYNC=false
PG_POOL_MAX=10

# Supabase Storage Configuration (Private bucket for student assignment attachments)
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_mock12345

# Payment Gateway (Mock / Sandbox)
RAZORPAY_KEY_ID=rzp_test_mock12345
RAZORPAY_KEY_SECRET=rzp_test_mocksecret12345
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Communications & SMS Settings (Mock mode for local dev)
SMS_PROVIDER=mock
SMS_SENDER_ID=ATTNDO

# Billing & Tax Configurations
COMPANY_NAME="AttendoSchool"
COMPANY_GSTIN="19AAACB1234P1Z5"
COMPANY_ADDRESS="Campus 4, Tech Park Boulevard, Bengaluru, Karnataka"
COMPANY_PHONE="+91 90000 00000"
COMPANY_GST_RATE=18

# -----------------------------------------------------------------
# Email Server Configuration (Gmail SMTP & Cloud HTTP APIs)
# -----------------------------------------------------------------
# For Render Free Tier: outbound SMTP ports 25, 465, 587 are blocked.
# Use BREVO_API_KEY (starts with 'xkeysib-'), RESEND_API_KEY ('re_...'), or GMAIL_RELAY_URL.
# For local dev or Render Paid instances, standard Gmail SMTP works directly.
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info.sahayog24x7@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AttendoSchool <info.sahayog24x7@gmail.com>"
SMTP_FROM_NAME=AttendoSchool
SMTP_REPLY_TO=info.sahayog24x7@gmail.com
EMAIL_ENABLED=true

# HTTPS Email Providers (Port 443 - 100% compatible with Render Free Tier):
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=info.sahayog24x7@gmail.com
BREVO_SENDER_NAME="AttendoSchool"
# RESEND_API_KEY=re_your_resend_api_key_here
# GMAIL_RELAY_URL=https://script.google.com/macros/s/your-script-id/exec
