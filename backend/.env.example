PORT=5000
DATABASE_URL=postgresql://attendance:attendance_dev_password@localhost:5432/attendance_saas
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CORS_ORIGIN=http://localhost:5173

# Firebase Cloud Firestore Database Configuration
# Option A: Service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B: Direct credentials (ideal for cloud deployments like Render/Railway/Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional: Local Firestore Emulator host (e.g. localhost:8080)
FIRESTORE_EMULATOR_HOST=

# SMS provider. Keep mock for local testing.
SMS_PROVIDER=mock
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=


# V09 Razorpay production configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMPANY_NAME=School Attendance SaaS
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_EMAIL=

# V10 email / invoice settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMPANY_PHONE=
COMPANY_GST_RATE=18
