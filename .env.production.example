NODE_ENV=production
PORT=5000
DB_HOST=db
DB_PORT=5432
DB_NAME=attendance
DB_USER=attendance_app
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET=CHANGE_THIS_TO_A_64_PLUS_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=https://attendance.example.com
DB_DRIVER=postgres
USE_POSTGRES=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
# RBAC feature/permission enforcement: off | shadow (default, log only) | enforce
RBAC_ENFORCEMENT=shadow

# Backups: SERVER/WORKER settings only. Never use a VITE_ prefix for secrets.
# Set the SAME absolute directory in web, worker and cron. See docs/backup.md.
BACKUP_DIR=/app/backups/private
BACKUP_AGE_RECIPIENT=
BACKUP_DATABASE_URL=
BACKUP_GITHUB_REPO=
BACKUP_GH_TOKEN=
BACKUP_RETENTION_DAYS=14
BACKUP_MONTHLY_KEEP=12
BACKUP_LOCAL_KEEP=3
BACKUP_FAILED_DAYS=7
BACKUP_UPLOAD_DIR=
BACKUP_UPLOAD_MAX_BYTES=1500000000
BACKUP_SPLIT_BYTES=1900000000
BACKUP_MIN_FREE_BYTES=1073741824
BACKUP_STALE_SECONDS=14400
BACKUP_HEARTBEAT_URL=
# Set true ONLY after verifying there are no external Supabase Storage objects.
BACKUP_STORAGE_DISABLED=false
# Set true ONLY after verifying legacy Firebase contains no unique live data.
BACKUP_FIREBASE_CONFIRMED_UNUSED=false
# Worker image default matches docker-compose.production.yml; confirm hosted DB major.
BACKUP_PG_MAJOR=16
