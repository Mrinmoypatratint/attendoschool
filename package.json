{
  "name": "attendoschool-workspace",
  "version": "0.11.0",
  "private": true,
  "description": "AttendoSchool Multi-Tenant Attendance SaaS Monorepo Root",
  "scripts": {
    "test:firebase": "npm --prefix backend run test:firebase",
    "seed:firestore": "npm --prefix backend run seed:firestore",
    "dev:backend": "npm --prefix backend run dev",
